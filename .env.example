# Número de WhatsApp del bot en formato E.164 SIN +, espacios ni guiones.
# Ejemplo México: 52 + los 10 dígitos del número.
WHATSAPP_NUMBER=522295191113

# Uno o varios administradores separados por coma, solo dígitos.
ADMINS=5359494299

# En local puede ser "sesion".
# En Railway usa la ruta de un Volume persistente, por ejemplo /data/chronos-session
SESSION_DIR=sesion

# Railway normalmente define PORT automáticamente.
PORT=3000
