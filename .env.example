NODE_ENV=production
PORT=3000
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.mongodb.net/chronos?retryWrites=true&w=majority

# WhatsApp bot number: E.164 digits only, no +, spaces or hyphens.
WHATSAPP_NUMBER=521234567890
# Use Railway Volume in production, e.g. /data/chronos-session
SESSION_DIR=/data/chronos-session

# Admin source of truth. passwordHash must be Argon2id.
# Run: npm run hash-password -- "YourStrongPassword"
CHRONOS_PANEL_USERS=[{"username":"owner","phone":"521234567890","role":"OWNER","passwordHash":"$argon2id$..."}]

JWT_SECRET=replace-with-at-least-32-random-characters
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
ADMIN_SECURITY_ENCRYPTION_KEY=replace-with-64-hex-characters

# Browser panel origin. Use comma-separated origins if needed.
CORS_ORIGINS=https://your-panel.example.com

# Private key required to view the pairing code at the backend root URL.
# Use at least 24 random characters. If empty, the pairing page stays disabled.
PAIRING_PAGE_TOKEN=replace-with-a-long-random-private-key
LOG_LEVEL=info

# Optional: if false, WhatsApp does not start (useful in tests/local API work)
WHATSAPP_ENABLED=true
# Reconciliation interval for groups, in minutes
GROUP_SYNC_INTERVAL_MINUTES=15
# Scheduler polling interval in seconds
SCHEDULER_POLL_SECONDS=15
